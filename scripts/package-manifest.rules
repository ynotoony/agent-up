# ==== scripts：脚本必需件（检查 8；成员表一致性检查 9）====
# kind 口径差定谳：test-record-layer.sh 定为必需件，kind 标 test-harness。

pm_script scripts/check-gates.sh script '道脚本：快道只读门禁核对器'
pm_script scripts/lane-commit.sh script '道脚本：快道合同驱动收尾'
pm_script scripts/check-stale-claims.sh script '易腐断言扫描器（票收口拦截＋会话启动警告）'
pm_script scripts/common-helpers.sh script '共享错误处理库（die1/die2/warn 函数）'
pm_script scripts/dp-load-rules.sh script 'delivery.rules 共享解析库（dp_load_rules 唯一实现＋DP_PARSER_VERSION 单一版本来源；四消费件同目录 source，缺件与版本漂移 fail-closed；文法说明 references/delivery-rules.md）'
pm_script scripts/json-helpers.sh script 'JSON 解析共享库（json_extract_string/json_extract_number/json_validate_row 函数）'
pm_script scripts/json-validator.py script 'Python JSON 校验模块（三类校验入口：ticket/grade/run）'
pm_script scripts/generate-progress.sh script '现役状态投影生成器'
pm_script scripts/generate-module-map.sh script '模块地图生成器'
pm_script scripts/ticket-ops.sh script '票务运维单入口（open/take/flip）'
pm_script scripts/run-record.sh script 'run record 生成器（new/seal/stats；本仓交付后存量清算入包采纳）'
pm_script scripts/ticket-grade.sh script '票定级建议器（建议不裁决；本仓交付后存量清算入包采纳）'
pm_script scripts/install.sh script '包侧安装器（安装政策执行引擎）'
pm_script scripts/check-append-only.sh script 'Record 只追加守卫（补登记——检查 17 机械行点名脚本须在册）'
pm_script scripts/check-artifacts.sh script '治理产物对账器（补登记——检查 17 机械行点名脚本须在册）'
pm_script scripts/export-payload.sh script '公开载荷导出单命令（delivery.rules 驱动六步：split→树比对→导出树 check-package→ff 断言→push→ls-remote 复核；--dry-run；永不 force；真跑主检出门禁）'
pm_script scripts/worktree-add.sh script 'worktree 栅栏化创建单命令（delivery.rules main-only 节驱动 sparse-checkout 排除＋主检出自拒＋分支形态断言）'
pm_script scripts/upgrade-check.sh script '落地面升级对账器（已治理仓对包新基线逐件三态 cmp：同步/落后/漂移；全程只读 fail-closed；升级流程入口 references/upgrade.md）'
pm_script scripts/module-map.rules rules '模块地图语言规则表（generate-module-map.sh 数据）'
pm_script scripts/install-policy.rules rules '安装政策数据表（install.sh 数据）'
pm_script scripts/test-record-layer.sh test-harness '记录层回归 harness（多 suite 常驻自检；定为必需件）'
pm_script scripts/tests dir '记录层 harness 拆分套件目录（test-runner.sh 派发器＋test-helpers.sh 共享断言＋19 个 suite-*.sh，经 test-record-layer.sh 入口委托；kind=dir 目录成员无 mode 语义）'
pm_script scripts/absorption-trigger.sh script '吸收触发器（R-DP-041 吸收面：同 scope 分数聚合出固化/禁区候选提示，提示不裁决；全程只读零写入）'
pm_script scripts/health-summary.sh script '体系仪表盘（四分区只读汇总：打分趋势/吸收候选/扫描报警/对账状态；零写入）'
pm_script scripts/workflow-executor.sh script 'Workflow 运行时执行器（YAML workflow 定义驱动的流程执行器：条件跳过、工具调用、checkpoint 落盘、中断续传）'
pm_script scripts/verify-contract.sh script '结构化验收谓词执行器（verification 对象数组逐条执行与断言；普通任务禁止空验证，纯记录须显式 record-only）'
pm_script scripts/check-dispatch-contract.sh script '双模式派发合同校验器（--check-template 模板零漂移核对＋--check 合同文件自查；schema 数据件在 references/schemas/）'
pm_script scripts/test-checkpoint-recovery.sh test-harness 'Checkpoint 中断续传回归测试（workflow-executor.sh 中断续传机制自检）'

