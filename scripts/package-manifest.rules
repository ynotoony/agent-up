# ==== vague-words：模糊措辞词表（检查 12；依据 R-GF-010 原文列举六词，字面匹配非正则）====

pm_vague_word '尽量'
pm_vague_word '适当'
pm_vague_word '必要时'
pm_vague_word '通常'
pm_vague_word '原则上'
pm_vague_word '酌情'

# ==== vague-exemptions：模糊措辞行级豁免（检查 12；行级豁免须注记理由，理由必填；
#      登记行无命中即失效豁免 FAIL，行号漂移须复核更新或删除登记）====

pm_vague_exempt references/protocol/governance-format.md 82 'R-GF-003 Forbidden 字段枚举禁用措辞——禁令条款内引述词表本身，换词即丢失枚举语义（R-GF-010 Evidence 明示禁令条款内引述除外）'
pm_vague_exempt references/protocol/governance-format.md 203 'R-GF-010 Forbidden 字段＝词表权威列举处（vague-words 节依据），禁令条款内引述除外'

# ==== mirrors：跨树同名脚本所有权登记（检查 13；每名恰一类别，登记域＝包侧 scripts/
#      与仓侧 scripts/、rules/implementation/scripts/ 的跨树同名脚本全集）：
#      mirror＝两侧同名件互为镜像逐对 cmp（byte 纪律，仓侧缺同名件即 FAIL）；
#      package-only＝包侧为唯一维护权威，不 cmp；仓侧同名实例在场属待升级流程同步的
#      过渡态（升级主链见 references/upgrade.md），不判差异不判存在；
#      repo-only＝仅仓侧存在、包侧明确不收录，包内出现同名件即 FAIL（防未决策采纳）。
#      仓根无镜像落位目录（scripts/ 与 rules/implementation/scripts/ 皆无＝消费项目）
#      整项静默跳过。main-only 件归 delivery.rules dp_mainonly 管辖不入本节。====

# -- mirror：两侧同名件互为镜像 --
pm_mirror generate-progress.sh mirror
pm_mirror ticket-ops.sh mirror
pm_mirror absorption-trigger.sh mirror
pm_mirror health-summary.sh mirror
pm_mirror run-record.sh mirror
pm_mirror ticket-grade.sh mirror
pm_mirror lane-commit.sh mirror
pm_mirror check-gates.sh mirror
pm_mirror upgrade-check.sh mirror
# -- package-only：包侧唯一维护权威（仓侧同名实例待升级流程同步的过渡态） --
# 解析器单源化过渡态：包侧两消费件改写为 source 共享解析库 dp-load-rules.sh，与仓侧
# 旧版内嵌解析器副本不再字节同构；仓侧同名实例为待升级流程收敛的过渡态（不判差异）。
pm_mirror check-stale-claims.sh package-only
pm_mirror worktree-add.sh package-only
pm_mirror check-dispatch-contract.sh package-only
pm_mirror test-checkpoint-recovery.sh package-only
pm_mirror verify-contract.sh package-only
pm_mirror workflow-executor.sh package-only
# -- repo-only：仅仓侧存在，包侧明确不收录 --
pm_mirror merge-ticket.sh repo-only
pm_mirror check-derived-freshness.sh repo-only
pm_mirror check-payload-boundary.sh repo-only
pm_mirror check-role-permissions.sh repo-only

# ==== capability-primitives：能力基元名单与检查目标（检查 14）====
# 九基元名自 references/adapters/capability-contract.md §2.1 权威表逐行现场提取登记
# （不自造基元；引擎零基元名硬编码）。targets 预期名单为各目标现行声明面/对照表现场
# 转录（decl＝三角色合同 required_capabilities 行；table＝五适配文件能力基元对照表，
# 各覆盖九基元）；基元或角色声明变化＝先改本节名单/预期名单，再改对应实物并同步
# harness 夹具（红灯不隔票）。

pm_capability inspect
pm_capability search
pm_capability read
pm_capability edit
pm_capability write
pm_capability execute
pm_capability readonly-execute
pm_capability vcs-read
pm_capability vcs-write
pm_capability_authority references/adapters/capability-contract.md
pm_capability_target references/templates/agents-implementation.md.tmpl decl 'inspect,search,read,edit,write,execute'
pm_capability_target references/templates/agents-review.md.tmpl decl 'inspect,search,read,readonly-execute'
pm_capability_target references/templates/agents-commit.md.tmpl decl 'inspect,vcs-read,vcs-write'
pm_capability_target references/adapters/zcode.md table 'inspect,search,read,edit,write,execute,readonly-execute,vcs-read,vcs-write'
pm_capability_target references/adapters/claude-code.md table 'inspect,search,read,edit,write,execute,readonly-execute,vcs-read,vcs-write'
pm_capability_target references/adapters/codex.md table 'inspect,search,read,edit,write,execute,readonly-execute,vcs-read,vcs-write'
pm_capability_target references/adapters/pi.md table 'inspect,search,read,edit,write,execute,readonly-execute,vcs-read,vcs-write'
pm_capability_target references/adapters/dsh.md table 'inspect,search,read,edit,write,execute,readonly-execute,vcs-read,vcs-write'

# ==== ticket-citation-ban：包内票号索引禁令豁免（检查 18）====
# 扫描面＝包内全部 *.md / *.tmpl / *.json / *.rules（*.sh 代码面不扫——断言名/注释语境
# 为不腐烂载体，扫禁归后续裁决）；模式＝「票 ?[0-9]{2,}」字面正则（本仓票号索引引用，
# 溯源改由 git commit message 与票本承载，citation-rot 定稿）。本节登记行级豁免：
# pm_cite_exempt <pkg-rel-path> <行号> <理由>（理由必填；登记行无命中即失效豁免
