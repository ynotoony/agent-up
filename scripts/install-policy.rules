# Input: 安装政策事实（单源化拍板）：门控集合构成、每文件复制基线路径与登记
#        lifecycle 值——唯一承载点；SKILL.md 主流程步骤 5、references/old-project.md §3、
#        scripts/README.md 口径段三处散文不再复写映射明细，只保留决策句与指向本表。
# Output: install.sh 引擎启动时按非执行式解析读本表（引擎不 source 本表）——每行一个
#         ip_gate / ip_file / ip_data 指令：
#         ip_gate <gate> <flag> <说明>（门控定义行：gate token、启用 flag、一句话说明）；
#         ip_file <pkg-rel-path> <lifecycle> <gate> <说明>（每脚本件×每门控一行：包内复制
#         基线路径、登记 lifecycle 值、所属门控、该门控下角色说明；同一文件属多个门控时
#         逐门控各一行，引擎按文件路径去重选取，落位目录固定 rules/implementation/scripts/）；
#         ip_data <pkg-rel-path> <target-rel-path> <lifecycle> <gate> <说明>（每数据件×每
#         门控一行：包内源路径、目标项目根相对落位路径、登记 lifecycle 值、所属门控、角色
#         说明——安装后运行时依赖闭包的 schema/profile 等数据件承载行，随消费脚本同门控
#         复制，落位路径须避开脚本落位目录）。
# Pos: 安装政策数据文件（先例 module-map.rules：外置数据＋引擎零专名＋结构校验
#      fail-closed）。复制哪些脚本与数据件、在什么门控下落位只在本表登记，install.sh 引擎
#      零脚本名零门控专名；加门控＝加一行 ip_gate＋若干 ip_file/ip_data，零引擎改动。
#      结构校验口径（install.sh 加载时逐行核验，任一不合预期即 exit 2 fail-closed，不写
#      任何文件）：字段数（ip_gate 恰 3、ip_file 恰 4、ip_data 恰 5，字段内禁制表符）；
#      gate token（小写字母开头，小写字母/数字/连字符）与 flag（-- 加小写 token，不得与
#      引擎保留参数 --target/-h/--help 冲突）字符集且跨行唯一；ip_file 基线路径须为
#      agent-up/scripts/ 前缀加单段文件名（禁 .. 与斜杠入名）；ip_data 源路径须为
#      agent-up/ 前缀多段路径、落位路径须为目标根相对多段路径（两者各段均为字母/数字
#      起点 token，禁 .. 段与前导/连续/尾随斜杠；落位路径禁侵入脚本落位目录）；lifecycle
#      须为非空 token（枚举权威＝references/templates/artifacts-yaml.tmpl：
#      Seed/Conditional/Record/Derived/Adapter，本表不复制枚举定义）；引用门控须已由
#      ip_gate 行定义；每门控至少一行 ip_file 或 ip_data；(文件/数据件,门控) 跨行不重复；
#      同文件跨行 lifecycle 必须一致；ip_data 落位路径跨行不重复且同数据件跨行一致。
#      本表、install.sh 引擎与同目录 README.md 专节三处登记须同步（政策映射变化时）。

# ---- 门控定义（启用判定是用户决策，脚本只承接已确认的复制动作）----

ip_gate fast-lane --fast-lane '用户确认启用分级交付道快道时复制道脚本（含投影生成器）'
ip_gate ticket-ops --ticket-ops '目标项目采用任务票体系时复制票务运维脚本（记录层标配，不门控于快道启用）'

# ---- 每文件×每门控：复制基线路径、登记 lifecycle、所属门控、角色说明 ----

ip_file agent-up/scripts/check-gates.sh Conditional fast-lane '道脚本：快道门禁核对器（白名单＋验证前后工作区快照，越界写一律失败）'
ip_file agent-up/scripts/lane-commit.sh Conditional fast-lane '道脚本：快道合同驱动收尾（索引翻转经 ticket-ops flip-index、Review Checkpoint 经 checkpoint-write、微账本经 ledger-append 三代理承载＋两段式提交；--record-commit 委托同目录 record-commit.sh）'
ip_file agent-up/scripts/record-commit.sh Conditional fast-lane '回退依赖：lane-commit --record-commit 兼容入口与两段式第二段提交实现（同目录定位，安装闭包；全仓唯一提交 plumbing）'
ip_file agent-up/scripts/worktree-add.sh Conditional fast-lane 'worktree 栅栏化创建单命令（R-DP-036 创建面栅栏；无栅栏配置的仓不强制使用）'
ip_file agent-up/scripts/upgrade-check.sh Conditional fast-lane '落地面升级对账器（已治理仓对包新基线逐件三态 cmp，全程只读；升级流程入口 references/upgrade.md）'
ip_file agent-up/scripts/generate-progress.sh Conditional fast-lane '现役状态投影生成器（收尾链由 ticket-ops 独占调用，快道随 lane-commit 翻转代理链一并依赖）'
ip_file agent-up/scripts/generate-dir-readmes.sh Conditional fast-lane '回退依赖：lane-commit 索引翻转至 done 的目录 README 收口预检运行依赖同目录生成器（经 ticket-ops flip-index 代理调用：结构 --check 与生成块 --freshness 两检；同目录定位，安装闭包）'
ip_file agent-up/scripts/artifacts-index.sh Conditional fast-lane '共享 artifacts 索引解析器：generate-dir-readmes --brief 素材证据解析运行依赖（同目录定位，安装闭包；与 check-artifacts 严格对账解析同源）'
ip_file agent-up/scripts/dir-readme.rules Conditional fast-lane '范围规则数据件：generate-dir-readmes.sh 缺省同目录查找的 include/exclude 行表（收口门禁范围唯一承载点；同目录定位，安装闭包）'
ip_file agent-up/scripts/checkpoint-write.sh Conditional fast-lane '回退依赖：lane-commit user-review 道 User Review Checkpoint 写入代理（唯一写入方，同目录定位，安装闭包）'
ip_file agent-up/scripts/ledger-append.sh Conditional fast-lane '回退依赖：lane-commit micro 道微账本落行唯一写入方（同目录定位，安装闭包）'
ip_file agent-up/scripts/record-store.sh Conditional fast-lane '记录层写面 module：道脚本侧 checkpoint-write（User Review Checkpoint 记录块）与 ledger-append（微账本落行）运行依赖（同目录定位，安装闭包；锁/路径表/原子替换/前缀断言唯一实现）'
ip_file agent-up/scripts/ticket-ops.sh Conditional fast-lane '回退依赖：lane-commit 索引翻转代理 flip-index 运行依赖同目录 ticket-ops（index.json 唯一写入方，目标项目未落位时一并复制）'
ip_file agent-up/scripts/ticket-ops.sh Conditional ticket-ops '票务运维单入口（open/take/flip/flip-index/ledger，index.json 唯一写入方，记录层标配）'
ip_file agent-up/scripts/ledger-append.sh Conditional ticket-ops 'changes.jsonl 唯一写入方：ticket-ops 账本落行与写前预检运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/record-store.sh Conditional ticket-ops '记录层写面 module：票务侧 ticket-ops（索引与 issues-README 四处写点）与 ticket-run（票本体 checkpoint.commit）运行依赖（同目录定位，安装闭包；记录路径表与三写动词唯一实现）'
ip_file agent-up/scripts/run-record.sh Conditional ticket-ops 'run record 生成器（new/seal/stats，记录层标配；本仓交付后存量清算入包采纳）'
ip_file agent-up/scripts/ticket-grade.sh Conditional ticket-ops '票定级建议器（建议不裁决，记录层标配；本仓交付后存量清算入包采纳）'
ip_file agent-up/scripts/absorption-trigger.sh Conditional ticket-ops '吸收触发器（R-DP-041 吸收面：分数聚合出固化/禁区候选提示，提示不裁决；行型地基＝教训账本分数键）'
ip_file agent-up/scripts/health-summary.sh Conditional ticket-ops '体系仪表盘（四分区只读汇总，打分/候选/报警/对账一屏看；视图非门禁）'
ip_file agent-up/scripts/json-line.sh Conditional ticket-ops '共享内联 JSON 行解析库：absorption-trigger 与 health-summary 运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/generate-progress.sh Conditional ticket-ops '回退依赖：票务收尾投影再生依赖同目录生成器（PATH 回退），目标项目未落位时一并复制'
ip_file agent-up/scripts/generate-dir-readmes.sh Conditional ticket-ops '目录 README 收口生成器：ticket-ops close 与 flip／flip-index 至 done 的结构 --check 与生成块 --freshness 两检运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/artifacts-index.sh Conditional ticket-ops '回退依赖：generate-dir-readmes --brief 素材证据解析运行依赖同目录共享 artifacts 索引解析器（与 check-artifacts 严格对账解析同源，安装闭包）'
ip_file agent-up/scripts/dir-readme.rules Conditional ticket-ops '范围规则数据件：generate-dir-readmes.sh 缺省同目录查找的 include/exclude 行表（缺件即收口预检 fail-closed；同目录定位，安装闭包）'
ip_file agent-up/scripts/common-helpers.sh Conditional fast-lane '共享错误处理库：道脚本运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/dp-load-rules.sh Conditional fast-lane 'delivery.rules 共享解析库：worktree-add 运行依赖（同目录定位，安装闭包；解析版本唯一来源 DP_PARSER_VERSION）'
ip_file agent-up/scripts/common-helpers.sh Conditional ticket-ops '共享错误处理库：票务脚本运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/json-validator.py Conditional fast-lane '唯一 JSON 引擎：generate-progress 投影再生与 worktree-add 合同入口运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/json-validator.py Conditional ticket-ops '唯一 JSON 引擎：ticket-grade 判据计算与 ticket-ops open/take/flip 各 JSON 门运行依赖（同目录定位，安装闭包）'
ip_file agent-up/scripts/contract-build.sh Conditional ticket-ops '派发合同渲染器：票 dispatch 节→stdout 派发合同（ticket-run 编排入口消费；同目录定位，安装闭包）'
ip_file agent-up/scripts/ticket-run.sh Conditional ticket-ops '主 agent 编排入口（可恢复协调器）：next/start/contract/record/verify-dispatch 五子命令＋legacy implementation/review/commit；next 只读且 decision-required 时 exit 1（--clear-intent 为残留 intent 登记清除路径）、start 建站＋领取幂等收敛、contract 产出站路径＋合同文件、record 幂等落位收据、verify-dispatch 三类拒绝；commit 自动两段提交（同目录原子层闭包；纯记录提交经 record-commit.sh 统一入口）'
ip_file agent-up/scripts/record-commit.sh Conditional ticket-ops '回退依赖：ticket-run commit 纯记录提交入口（同目录定位，安装闭包；与 lane-commit 第二段同一实现）'
ip_file agent-up/scripts/ticket-split.sh Conditional ticket-ops '拆票批量入口：批量 open＋一次性记录提交（fail-closed／幂等；同目录定位安装闭包，依赖 ticket-ops／record-commit／record-store／common-helpers／json-validator／ledger-append／generate-progress）'
ip_file agent-up/scripts/worktree-add.sh Conditional ticket-ops '回退依赖：ticket-run implementation 建站原子层（主检出栅栏与站路径派生，同目录定位，安装闭包）'
ip_file agent-up/scripts/dp-load-rules.sh Conditional ticket-ops '回退依赖：ticket-run 建站链 worktree-add 的 delivery.rules 共享解析器（同目录定位，安装闭包）'
ip_file agent-up/scripts/check-gates.sh Conditional ticket-ops '回退依赖：ticket-run commit 的范围与白名单门禁（含验证前后工作区快照；同目录定位，安装闭包）'
ip_file agent-up/scripts/check-dispatch-contract.sh Conditional ticket-ops '派发合同校验器：contract-build 输出前自校验依赖（同目录定位，安装闭包）'
ip_data agent-up/references/schemas/ticket-record.schema.json rules/implementation/references/schemas/ticket-record.schema.json Conditional ticket-ops '票本体 schema：ticket-ops open 本体校验运行依赖（脚本邻接 references/ 定位，安装闭包数据件）'
ip_data agent-up/references/protocol/complexity-profile.md rules/implementation/references/protocol/complexity-profile.md Conditional ticket-ops '定级判据权威手册：ticket-grade 判据数据（脚本邻接 references/ 定位，安装闭包数据件）'
ip_data agent-up/references/schemas/dispatch-contract.schema.json rules/implementation/references/schemas/dispatch-contract.schema.json Conditional ticket-ops '派发合同占位符清单：ticket-ops open dispatch 门键集权威与 contract-build 渲染字段清单（脚本邻接 references/ 定位，安装闭包数据件）'
ip_data agent-up/references/prompts/implementation-prompt.md rules/implementation/references/prompts/implementation-prompt.md Conditional ticket-ops 'implementation 派发合同模板：check-dispatch-contract require_inputs 依赖（校验器邻接 references/ 定位，安装闭包数据件）'
ip_data agent-up/references/prompts/review-prompt.md rules/implementation/references/prompts/review-prompt.md Conditional ticket-ops 'review 派发合同模板：check-dispatch-contract require_inputs 依赖（校验器邻接 references/ 定位，安装闭包数据件）'
ip_data agent-up/references/prompts/commit-prompt.md rules/implementation/references/prompts/commit-prompt.md Conditional ticket-ops 'commit 派发合同模板：check-dispatch-contract require_inputs 依赖（校验器邻接 references/ 定位，安装闭包数据件）'
ip_file agent-up/scripts/project-dashboard.html Conditional ticket-ops '本地项目仪表盘（单文件只读 HTML：用户点击选择项目根后读 module-map.json、票索引与全部卡片并轮询刷新；零网络零写入）'
ip_file agent-up/scripts/ticket-audit.sh Conditional ticket-ops '证据审计引擎：<NN> 票审查收据＋十一谓词只读审计（操作面 analyze/read 放行未知，merge/push 以 conformant 为门，P04 允许集显式传入；同目录定位 common-helpers.sh 与 json-validator.py 安装闭包）'
ip_file agent-up/scripts/merge-ticket.sh Conditional fast-lane '合并站脚本：票分支→main（ff→--no-ff→冲突 abort 停等，成功清 worktree/分支）；合并前证据门调同目录 ticket-audit --operation merge，缺 conformant 即拒绝（done/merge 证据门）；main 已前进的重绑须 --authorize-rebind 显式授权并由 evidence-rebind.sh 落账留痕'
ip_file agent-up/scripts/evidence-rebind.sh Conditional fast-lane '回退依赖：merge-ticket main 已前进时 rebase 后审查证据重绑（显式授权＋账本留痕；同目录定位，安装闭包）'
